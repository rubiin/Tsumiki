{
  "name": "tsumiki-site",
  "version": "1.1.1",
  "description": "Tsumiki Documentation Site",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro sync && tsc --noEmit -p tsconfig.check.json && astro build",
    "check": "astro sync && tsc --noEmit -p tsconfig.check.json",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.2.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
