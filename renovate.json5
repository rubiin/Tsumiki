{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "labels": [
        "dependencies"
    ],
    "rangeStrategy": "bump",
    "extends": [
        "config:recommended"
    ],
    "enabledManagers": [
        "pep621",
        "uv",
        "npm",
        "github-actions"
    ],
    "packageRules": [
    {
      "matchPackageNames": ["PyGObject","PyGObject-stubs"],
      "enabled": false
    },
        {
            "matchManagers": [
                "pep621",
                "uv"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch"
        },
        {
            "matchManagers": [
                "pep621",
                "uv"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "all major dependencies",
            "groupSlug": "all-major-patch"
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "all non-major npm dependencies",
            "groupSlug": "npm-all-minor-patch"
        },
        {
            "matchManagers": [
                "npm"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "all major npm dependencies",
            "groupSlug": "npm-all-major"
        },
        {
            "matchFileNames": [
                "docs/package.json"
            ],
            "labels": [
                "dependencies",
                "docs"
            ]
        }
    ],
    "schedule": [
        "before 2am on Saturday"
    ]
}
